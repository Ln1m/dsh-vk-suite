{
  "name": "dsh-vk-settings-hub",
  "version": "0.1.0",
  "description": "设置页导航中枢：接管官方设置左栏，正文仍由官方 shell 渲染。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
