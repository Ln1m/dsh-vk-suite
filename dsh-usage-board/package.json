{
    "name": "dsh-usage-board",
    "version": "0.1.0",
    "description": "DSH 设置页预留位的用量看板：近 30/90 天方格热力图、时段分布、构成与峰谷占比、会话消耗排行、本会话明细与阈值。",
    "type": "module",
    "main": "lib/index.js",
    "exports": {
        ".": {
            "default": "./lib/index.js"
        },
        "./client": {
            "default": "./lib/client.js"
        },
        "./package.json": "./package.json"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "inject": [
                "dsh-vk-contract"
            ],
            "platform": "web"
        }
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "^4.0.2"
    },
    "files": [
        "lib",
        "cordis.patch.yml"
    ],
    "license": "MIT",
    "keywords": [
        "dsh",
        "deepseek-harness",
        "plugin",
        "usage",
        "heatmap",
        "wallet"
    ],
    "author": "Ln1m (https://github.com/Ln1m)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ln1m/dsh-vk-suite.git",
        "directory": "dsh-usage-board"
    },
    "homepage": "https://github.com/Ln1m/dsh-vk-suite/tree/main/dsh-usage-board#readme",
    "bugs": {
        "url": "https://github.com/Ln1m/dsh-vk-suite/issues"
    }
}
